<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>UNDERPAID</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;

      background: #f5f1e8;
      color: #222;

      font-family: Arial, sans-serif;
    }

    .container {
      width: 90%;
      max-width: 550px;
    }

    h1 {
      font-size: 42px;
      margin-bottom: 8px;
      letter-spacing: 3px;
    }

    p {
      margin-top: 0;
      margin-bottom: 30px;
      color: #666;
    }

    textarea {
      width: 100%;
      min-height: 180px;

      padding: 16px;

      font-family: inherit;
      font-size: 16px;

      border: 2px solid #222;
      background: transparent;

      resize: vertical;
      outline: none;
    }

    textarea:focus {
      background: #fff;
    }

    button {
      margin-top: 12px;
      padding: 12px 28px;

      border: 2px solid #222;
      background: #222;
      color: white;

      font-size: 15px;
      cursor: pointer;
    }

    button:hover {
      background: transparent;
      color: #222;
    }

    .small {
      margin-top: 18px;
      font-size: 12px;
      color: #999;
    }
  </style>
</head>

<body>

  <main class="container">

    <h1>UNDERPAID</h1>

    <p>Have a question? Ask us anything.</p>

    <form
      action="https://formsubmit.co/pis2009@nyu.edu"
      method="POST"
    >

      <textarea
        name="message"
        placeholder="Your question..."
        required
      ></textarea>

      <input
        type="hidden"
        name="_subject"
        value="New question from UNDERPAID website"
      >

      <input
        type="hidden"
        name="_captcha"
        value="false"
      >

      <button type="submit">
        Send
      </button>

    </form>

    <div class="small">
      UNDERPAID © 2026
    </div>

  </main>

</body>
</html>
